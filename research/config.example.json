{
  "schema_version": 1,
  "offline_only": true,
  "fail_on_critical_leakage": true,
  "output_dir": "outputs/static-jcr-2025",
  "dataset": {
    "path": "../benchmark_artifacts/recent_journals/dataset.jsonl",
    "query_fields": [
      "title",
      "abstract"
    ],
    "relevance_field": "gold_journal_id"
  },
  "corpus": {
    "type": "jcr_csv",
    "path": "../data/jcr_partition_2025.csv",
    "snapshot_date": "2025-12-31",
    "allowed_levels": [
      "Q1",
      "Q2",
      "Q3",
      "Q4"
    ],
    "text_fields": [
      "name",
      "area",
      "area_en",
      "jcr_category_1",
      "jcr_category_2",
      "jcr_category_3",
      "jcr_category_4",
      "jcr_category_5",
      "jcr_category_6"
    ],
    "excluded_post_test_fields": [
      "收稿方向_官网摘取",
      "收稿方向_证据",
      "收稿方向_更新时间"
    ]
  },
  "temporal_split": {
    "start": "2026-01-01",
    "train_end": "2026-03-31",
    "validation_end": "2026-05-31",
    "test_end": "2026-06-30"
  },
  "baselines": [
    {
      "name": "bm25",
      "type": "bm25",
      "k1": 1.2,
      "b": 0.75
    },
    {
      "name": "tfidf",
      "type": "tfidf",
      "sublinear_tf": true
    }
  ],
  "imported_runs": [],
  "fusions": [
    {
      "name": "rrf",
      "type": "rrf",
      "sources": [
        "bm25",
        "tfidf"
      ],
      "rrf_k": 60
    },
    {
      "name": "learned_linear",
      "type": "learned_linear",
      "sources": [
        "bm25",
        "tfidf"
      ],
      "epochs": 200,
      "learning_rate": 0.08,
      "l2": 0.01,
      "hard_negatives": 20
    }
  ],
  "evaluation": {
    "retrieval_depth": 100,
    "cutoffs": [
      1,
      3,
      5,
      10,
      20,
      50
    ]
  },
  "statistics": {
    "bootstrap_iterations": 2000,
    "permutation_iterations": 2000,
    "confidence": 0.95,
    "seed": 20260814,
    "comparisons": [
      {
        "left": "rrf",
        "right": "tfidf",
        "metric": "ndcg@10"
      },
      {
        "left": "learned_linear",
        "right": "tfidf",
        "metric": "ndcg@10"
      }
    ]
  }
}
