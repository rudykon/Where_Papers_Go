# Non-secret systemd runtime settings. Copy to:
#   ~/.config/where-papers-go/runtime.env
# and keep the installed file mode at 0600.

# Use 127.0.0.1 once the HTTPS reverse proxy is active. A temporary 0.0.0.0
# listener is appropriate only on the explicitly documented trusted LAN.
WPG_HOST=127.0.0.1
WPG_PORT=8001

# Keep production artifacts/config separate from a shadow release worktree.
# These must be absolute paths; the examples are intentionally placeholders.
WPG_DATA_DIR=/absolute/path/to/Where_Papers_Go/data
WPG_API_CONFIG=/absolute/path/to/Where_Papers_Go/llmapi.json

WPG_RATE_LIMIT_REQUESTS=6
WPG_RATE_LIMIT_WINDOW_SECONDS=60
WPG_MAX_CONCURRENT_SEARCHES=2
WPG_REQUEST_BODY_LIMIT=200000
WPG_REQUEST_READ_TIMEOUT=30
WPG_AUDIT_LOG=1

# Enable these only when requests arrive from the local Nginx/Caddy proxy.
WPG_TRUST_PROXY_HEADERS=1
WPG_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Optional direct-API bearer authentication. The token file must be a regular
# 0600 file containing one random token of at least 32 characters. Do not use
# this mode for the browser UI behind Nginx Basic Auth because both mechanisms
# use the Authorization header.
WPG_REQUIRE_API_AUTH=0
# WPG_API_TOKEN_FILE=/home/USER/.config/where-papers-go/api.token
