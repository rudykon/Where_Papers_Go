# Non-secret systemd runtime settings. Copy to:
#   ~/.config/where-papers-go/runtime.env
# and keep the installed file mode at 0600.

# Keep the default loopback listener before and after an HTTPS reverse proxy is
# activated. A temporary 0.0.0.0 listener is appropriate only on an explicitly
# reviewed trusted LAN. The audited systemd renderer accepts IPv4/localhost
# listeners because its startup health gate probes 127.0.0.1; do not put ::/::1
# in this service environment.
WPG_HOST=127.0.0.1
WPG_PORT=8001

# Keep production artifacts/config separate from a shadow release worktree.
# These must be absolute paths; the examples are intentionally placeholders.
WPG_DATA_DIR=/absolute/path/to/Where_Papers_Go/data
WPG_API_CONFIG=/absolute/path/to/Where_Papers_Go/llmapi.json

# First create this ignored/private generation with `prepare-runtime`, validate
# it, and select it with `activate-runtime`. The renderer resolves `current` to
# one concrete generation before writing the installed environment. Runtime
# caches and query-time LightRAG activity stay here; protected data is read-only.
WPG_API_CACHE_DIR=/home/USER/.local/state/where-papers-go/generations/generation-UTC-BINDING/api_cache
WPG_RESULT_CACHE_DIR=/home/USER/.local/state/where-papers-go/generations/generation-UTC-BINDING/api_cache/result
WPG_QUERY_EMBEDDING_CACHE=/home/USER/.local/state/where-papers-go/generations/generation-UTC-BINDING/query_embedding_cache.json.gz
WPG_LIGHTRAG_EMBEDDING_CACHE=/home/USER/.local/state/where-papers-go/generations/generation-UTC-BINDING/lightrag_embedding_cache.json.gz
WPG_LIGHTRAG_WORKING_DIR=/home/USER/.local/state/where-papers-go/generations/generation-UTC-BINDING/lightrag_storage
WPG_GRAPH_PATH=/absolute/path/to/Where_Papers_Go/data/venue_graph.json.gz

# Tavily quota/order state is shared across every generation and rollback. It
# must never be placed inside a generation or reset during a runtime switch.
# Create/audit it only with `prepare-shared-state` while the old service is
# stopped; migration preserves the legacy state files under WPG_DATA_DIR.
WPG_TAVILY_STATE_FILE=/home/USER/.local/state/where-papers-go/shared/.tavily_key_pool_state.json

# Bind health and the worker to the selected generation's immutable mode-0400
# manifest. Replace the digest with the exact 64-hex `manifest_sha256` printed
# by `prepare-runtime`; never hand-edit the manifest after cache writes begin.
WPG_RUNTIME_GENERATION=/home/USER/.local/state/where-papers-go/generations/generation-UTC-BINDING
WPG_RUNTIME_MANIFEST=/home/USER/.local/state/where-papers-go/generations/generation-UTC-BINDING/runtime-shadow-manifest.json
WPG_RUNTIME_MANIFEST_SHA256=64_HEX_MANIFEST_SHA256_FROM_PREPARE_RUNTIME
WPG_STRICT_GRAPH_READ_ONLY=1
WPG_REQUIRE_RUNTIME_SHADOW=1

WPG_RATE_LIMIT_REQUESTS=6
WPG_RATE_LIMIT_WINDOW_SECONDS=60
WPG_MAX_CONCURRENT_CONNECTIONS=64
WPG_MAX_CONCURRENT_SEARCHES=2
WPG_REQUEST_BODY_LIMIT=200000
WPG_REQUEST_READ_TIMEOUT=30
WPG_AUDIT_LOG=1

# Every HTTP path is restricted by the direct TCP peer address. Keep the
# default loopback-only. A temporary trusted-LAN listener must explicitly add
# only its real subnet, for example 172.22.13.0/24; forwarded headers never
# participate in this perimeter check.
WPG_ALLOWED_CLIENT_CIDRS=127.0.0.0/8,::1/128

# Change this to 1 only when requests arrive from the local Nginx/Caddy proxy.
WPG_TRUST_PROXY_HEADERS=0
WPG_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128

# Optional direct-API bearer authentication. The token file must be a regular
# 0600 file containing one random token of at least 32 characters. Do not use
# this mode for the browser UI behind Nginx Basic Auth because both mechanisms
# use the Authorization header.
WPG_REQUIRE_API_AUTH=0
# WPG_API_TOKEN_FILE=/home/USER/.config/where-papers-go/api.token
