# Install this rendered file in /etc/nginx/conf.d/where-papers-go.conf.
# It intentionally contains no credential, certificate, or hostname value.

limit_req_zone $binary_remote_addr zone=wpg_search:10m rate=6r/m;

log_format wpg_json escape=json
  '{"time":"$time_iso8601","request_id":"$request_id",'
  '"remote_addr":"$remote_addr","method":"$request_method",'
  '"path":"$uri","status":$status,"bytes":$body_bytes_sent,'
  '"request_time":$request_time,"upstream_time":"$upstream_response_time"}';

upstream where_papers_go_backend {
    server 127.0.0.1:@@UPSTREAM_PORT@@;
    keepalive 8;
}

server {
    listen 80;
    listen [::]:80;
    server_name @@SERVER_NAME@@;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @@SERVER_NAME@@;

    ssl_certificate @@TLS_CERTIFICATE@@;
    ssl_certificate_key @@TLS_CERTIFICATE_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:WPGTLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    auth_basic "Where Papers Go";
    auth_basic_user_file @@HTPASSWD@@;

    access_log /var/log/nginx/where-papers-go.access.json wpg_json;
    error_log /var/log/nginx/where-papers-go.error.log warn;
    client_max_body_size 200k;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location ~ ^/api/search(?:/stream)?$ {
        limit_req zone=wpg_search burst=2 nodelay;
        limit_req_status 429;
        proxy_pass http://where_papers_go_backend;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_read_timeout 905s;
        proxy_send_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        # Never forward the proxy's Basic credential into application logs.
        proxy_set_header Authorization "";
    }

    location / {
        proxy_pass http://where_papers_go_backend;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Authorization "";
    }
}
