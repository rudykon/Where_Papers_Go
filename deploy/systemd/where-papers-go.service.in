[Unit]
Description=Where Papers Go venue recommendation service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@@PROJECT_ROOT@@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=WPG_HOST=127.0.0.1
Environment=WPG_PORT=8001
Environment=WPG_DATA_DIR=@@DATA_DIR@@
Environment=WPG_API_CONFIG=@@CONFIG_PATH@@
Environment=WPG_RATE_LIMIT_REQUESTS=6
Environment=WPG_RATE_LIMIT_WINDOW_SECONDS=60
Environment=WPG_MAX_CONCURRENT_SEARCHES=2
Environment=WPG_REQUEST_BODY_LIMIT=200000
Environment=WPG_REQUEST_READ_TIMEOUT=30
Environment=WPG_TRUST_PROXY_HEADERS=0
Environment=WPG_AUDIT_LOG=1
EnvironmentFile=%h/.config/where-papers-go/runtime.env
ExecStart=@@PYTHON@@ -m where_paper_go.web_app
ExecStartPost=@@PYTHON@@ -m scripts.manage_deployment health --url http://127.0.0.1:${WPG_PORT}/api/health --attempts 120 --interval 1 --timeout 2
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=45
KillSignal=SIGINT
KillMode=control-group
UMask=0077
LimitNOFILE=65536
TasksMax=256
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
ReadOnlyPaths=@@PROJECT_ROOT@@
ReadWritePaths=@@DATA_DIR@@
StandardOutput=journal
StandardError=journal
SyslogIdentifier=where-papers-go

[Install]
WantedBy=default.target
