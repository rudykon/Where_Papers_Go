[Unit]
Description=Where Papers Go venue recommendation service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@@SOURCE_RELEASE@@
Environment=WPG_HOST=127.0.0.1
Environment=WPG_PORT=8001
Environment=WPG_DATA_DIR=@@DATA_DIR@@
Environment=WPG_API_CONFIG=@@CONFIG_PATH@@
Environment=WPG_API_CACHE_DIR=@@RUNTIME_DIR@@/api_cache
Environment=WPG_RESULT_CACHE_DIR=@@RUNTIME_DIR@@/api_cache/result
Environment=WPG_QUERY_EMBEDDING_CACHE=@@RUNTIME_DIR@@/query_embedding_cache.json.gz
Environment=WPG_LIGHTRAG_EMBEDDING_CACHE=@@RUNTIME_DIR@@/lightrag_embedding_cache.json.gz
Environment=WPG_LIGHTRAG_WORKING_DIR=@@RUNTIME_DIR@@/lightrag_storage
Environment=WPG_GRAPH_PATH=@@DATA_DIR@@/venue_graph.json.gz
Environment=WPG_TAVILY_STATE_FILE=@@SHARED_STATE_DIR@@/.tavily_key_pool_state.json
Environment=WPG_RUNTIME_GENERATION=@@RUNTIME_DIR@@
Environment=WPG_RUNTIME_MANIFEST=@@RUNTIME_DIR@@/runtime-shadow-manifest.json
Environment=WPG_RUNTIME_MANIFEST_SHA256=@@RUNTIME_MANIFEST_SHA256@@
Environment=WPG_PYTHON_RUNTIME=@@PYTHON_RUNTIME@@
Environment=WPG_PYTHON_RUNTIME_MANIFEST=@@PYTHON_RUNTIME_MANIFEST@@
Environment=WPG_PYTHON_RUNTIME_MANIFEST_SHA256=@@PYTHON_RUNTIME_MANIFEST_SHA256@@
Environment=WPG_PYTHON_RUNTIME_TREE_SHA256=@@PYTHON_RUNTIME_TREE_SHA256@@
Environment=WPG_STRICT_GRAPH_READ_ONLY=1
Environment=WPG_REQUIRE_RUNTIME_SHADOW=1
Environment=WPG_RATE_LIMIT_REQUESTS=6
Environment=WPG_RATE_LIMIT_WINDOW_SECONDS=60
Environment=WPG_MAX_CONCURRENT_CONNECTIONS=64
Environment=WPG_MAX_CONCURRENT_SEARCHES=2
Environment=WPG_REQUEST_BODY_LIMIT=200000
Environment=WPG_REQUEST_READ_TIMEOUT=30
Environment=WPG_ALLOWED_CLIENT_CIDRS=127.0.0.0/8,::1/128
Environment=WPG_TRUST_PROXY_HEADERS=1
Environment=WPG_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128
Environment=WPG_REQUIRE_API_AUTH=1
Environment=WPG_API_TOKEN_FILE=@@API_TOKEN_FILE@@
Environment=WPG_AUDIT_LOG=1
# Every production WPG binding is rendered directly above.  Deliberately do
# not consume a mutable EnvironmentFile: an ordinary later restart must not be
# able to override the loopback/auth/allowlist/path contract.
# Applied before /usr/bin/env itself is loaded. This blocks loader/Python
# injection at the systemd exec boundary.
UnsetEnvironment=GCONV_PATH GLIBC_TUNABLES LD_ASSUME_KERNEL LD_AUDIT LD_BIND_NOT LD_BIND_NOW LD_DEBUG LD_DEBUG_OUTPUT LD_DYNAMIC_WEAK LD_HWCAP_MASK LD_LIBRARY_PATH LD_ORIGIN_PATH LD_PREFER_MAP_32BIT_EXEC LD_PRELOAD LD_PROFILE LD_SHOW_AUXV LD_TRACE_LOADED_OBJECTS OPENSSL_CONF OPENSSL_CONF_INCLUDE OPENSSL_ENGINES OPENSSL_MODULES SSLKEYLOGFILE SSL_CERT_FILE SSL_CERT_DIR REQUESTS_CA_BUNDLE CURL_CA_BUNDLE AWS_CA_BUNDLE GRPC_DEFAULT_SSL_ROOTS_FILE_PATH HTTP_PROXY HTTPS_PROXY ALL_PROXY NO_PROXY http_proxy https_proxy all_proxy no_proxy PYTHONBREAKPOINT PYTHONCASEOK PYTHONDEBUG PYTHONDEVMODE PYTHONDUMPREFS PYTHONEXECUTABLE PYTHONFAULTHANDLER PYTHONHASHSEED PYTHONHOME PYTHONINSPECT PYTHONMALLOC PYTHONOPTIMIZE PYTHONPATH PYTHONPLATLIBDIR PYTHONPROFILEIMPORTTIME PYTHONPYCACHEPREFIX PYTHONSTARTUP PYTHONTRACEMALLOC PYTHONUSERBASE PYTHONWARNINGS
# Command-local /usr/bin/env assignments independently repeat the approved
# import roots and source/Python runtime identities at the exec boundary.
ExecStart=/usr/bin/env -u GCONV_PATH -u GLIBC_TUNABLES -u LD_ASSUME_KERNEL -u LD_HWCAP_MASK -u PYTHONHOME -u PYTHONPLATLIBDIR -u LD_PRELOAD -u LD_LIBRARY_PATH -u LD_AUDIT -u OPENSSL_CONF -u OPENSSL_CONF_INCLUDE -u OPENSSL_ENGINES -u OPENSSL_MODULES -u SSLKEYLOGFILE -u SSL_CERT_FILE -u SSL_CERT_DIR -u REQUESTS_CA_BUNDLE -u CURL_CA_BUNDLE -u AWS_CA_BUNDLE -u GRPC_DEFAULT_SSL_ROOTS_FILE_PATH -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u NO_PROXY -u http_proxy -u https_proxy -u all_proxy -u no_proxy -u PYTHONINSPECT -u PYTHONSTARTUP -u PYTHONWARNINGS -u PYTHONBREAKPOINT PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1 PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 UV_OFFLINE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONPATH=@@SOURCE_RELEASE@@:@@PYTHON_IMPORT_PATH@@ WPG_SOURCE_HEAD=@@SOURCE_HEAD@@ WPG_SOURCE_TREE=@@SOURCE_TREE@@ WPG_SOURCE_MANIFEST=@@SOURCE_MANIFEST@@ WPG_SOURCE_MANIFEST_SHA256=@@SOURCE_MANIFEST_SHA256@@ WPG_PYTHON_RUNTIME=@@PYTHON_RUNTIME@@ WPG_PYTHON_RUNTIME_MANIFEST=@@PYTHON_RUNTIME_MANIFEST@@ WPG_PYTHON_RUNTIME_MANIFEST_SHA256=@@PYTHON_RUNTIME_MANIFEST_SHA256@@ WPG_PYTHON_RUNTIME_TREE_SHA256=@@PYTHON_RUNTIME_TREE_SHA256@@ @@PYTHON@@ -S -P -B -m where_paper_go.web_app
# The deployment renderer deliberately accepts only IPv4/localhost WPG_HOST,
# so this loopback startup gate cannot disagree with the listener family.
ExecStartPost=/usr/bin/env -u GCONV_PATH -u GLIBC_TUNABLES -u LD_ASSUME_KERNEL -u LD_HWCAP_MASK -u PYTHONHOME -u PYTHONPLATLIBDIR -u LD_PRELOAD -u LD_LIBRARY_PATH -u LD_AUDIT -u OPENSSL_CONF -u OPENSSL_CONF_INCLUDE -u OPENSSL_ENGINES -u OPENSSL_MODULES -u SSLKEYLOGFILE -u SSL_CERT_FILE -u SSL_CERT_DIR -u REQUESTS_CA_BUNDLE -u CURL_CA_BUNDLE -u AWS_CA_BUNDLE -u GRPC_DEFAULT_SSL_ROOTS_FILE_PATH -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u NO_PROXY -u http_proxy -u https_proxy -u all_proxy -u no_proxy -u PYTHONINSPECT -u PYTHONSTARTUP -u PYTHONWARNINGS -u PYTHONBREAKPOINT PATH=/usr/bin:/bin PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 PYTHONSAFEPATH=1 PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 UV_OFFLINE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 PYTHONPATH=@@SOURCE_RELEASE@@:@@PYTHON_IMPORT_PATH@@ WPG_SOURCE_HEAD=@@SOURCE_HEAD@@ WPG_SOURCE_TREE=@@SOURCE_TREE@@ WPG_SOURCE_MANIFEST=@@SOURCE_MANIFEST@@ WPG_SOURCE_MANIFEST_SHA256=@@SOURCE_MANIFEST_SHA256@@ WPG_PYTHON_RUNTIME=@@PYTHON_RUNTIME@@ WPG_PYTHON_RUNTIME_MANIFEST=@@PYTHON_RUNTIME_MANIFEST@@ WPG_PYTHON_RUNTIME_MANIFEST_SHA256=@@PYTHON_RUNTIME_MANIFEST_SHA256@@ WPG_PYTHON_RUNTIME_TREE_SHA256=@@PYTHON_RUNTIME_TREE_SHA256@@ @@PYTHON@@ -S -P -B -m scripts.manage_deployment health --url http://127.0.0.1:8001/api/health --token-file @@API_TOKEN_FILE@@ --attempts 120 --interval 1 --timeout 2 --expect-process-pid ${MAINPID} --expect-sha256 @@RUNTIME_DIR@@/runtime-shadow-manifest.json=@@RUNTIME_MANIFEST_SHA256@@ --expect-sha256 @@SOURCE_MANIFEST@@=@@SOURCE_MANIFEST_SHA256@@ --expect-sha256 @@PYTHON_RUNTIME_MANIFEST@@=@@PYTHON_RUNTIME_MANIFEST_SHA256@@
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=45
KillSignal=SIGINT
KillMode=control-group
UMask=0077
LimitNOFILE=65536
TasksMax=256
NoNewPrivileges=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadOnlyPaths=@@SOURCE_RELEASE@@
ReadOnlyPaths=@@PYTHON_RUNTIME@@
ReadOnlyPaths=@@DATA_DIR@@
ReadWritePaths=@@RUNTIME_DIR@@
ReadWritePaths=@@SHARED_STATE_DIR@@
# The generation contains mutable caches, but its identity contract itself is
# kernel-mounted read-only for the service. Health also verifies its 0400 mode
# and exact pre-approved SHA-256.
ReadOnlyPaths=@@RUNTIME_DIR@@/runtime-shadow-manifest.json
StandardOutput=journal
StandardError=journal
SyslogIdentifier=where-papers-go

[Install]
WantedBy=default.target
